API_HACIENDA_ENV=development
API_HACIENDA_LOG_LEVEL=INFO
# Native mode only: keep fallback empty.
API_HACIENDA_PHP_FALLBACK_URL=
API_HACIENDA_REQUEST_TIMEOUT_SECONDS=30
API_HACIENDA_DATABASE_URL=mysql+pymysql://testuser:testpassword@localhost:4407/testdb
API_HACIENDA_CRYPTO_KEY=
API_HACIENDA_USERS_SESSION_LIFETIME=-1
API_HACIENDA_FILES_BASE_PATH=/app/runtime/files/
API_HACIENDA_CORE_SITE_NAME=Mi Sitio
API_HACIENDA_MAIL_NOREPLY=no-reply@crlibre.org
API_HACIENDA_MAIL_TYPE=mail
API_HACIENDA_MAIL_ADDRESS=
API_HACIENDA_MAIL_HOST=
API_HACIENDA_MAIL_USERNAME=
API_HACIENDA_MAIL_PASSWORD=
API_HACIENDA_MAIL_SECURE=tls
API_HACIENDA_MAIL_PORT=587
