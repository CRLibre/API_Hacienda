api/resources
api/errors/*
nbproject/*
build/*
# *settings.php
.DS_Store
.vscode
validation_data.json

# content of settings.php is autogenerated
# www/settings.php

# Mysql Volume
/mysql-data/*
!/mysql-data/.gitkeep

# ignore IDE/hidden/OS cache files
*~
nbproject
nb-configuration.xml
Session.vim
*.tmproj
*.tmproject
tmtags
Thumbs.db
Desktop.ini
.idea

# ignore Composer downloads
/vendor/*

# keep some hiddens
!.htaccess
!/.gitignore
!/.travis.yml

# www/settings.php
*.AppleDouble
*.DS_Store
**/*.AppleDouble
.gitsecret/keys/random_seed
!*.secret
random_seed
junit-report.html
junit-report.xml
.env

# Python cache artifacts
__pycache__/
*.py[cod]

