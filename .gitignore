# Specific Files to ignore
nbproject/*
build/*
.DS_Store
.vscode
validation_data.json

# Mysql Volume
/migration/infra/mysql-data/*
!/migration/infra/mysql-data/.gitkeep

# ignore IDE/hidden/OS cache files
*~
nbproject
nb-configuration.xml
Session.vim
*.tmproj
*.tmproject
tmtags
Thumbs.db
Desktop.ini
.idea

# keep some hiddens
!.htaccess
!/.gitignore
!/.travis.yml

*.AppleDouble
*.DS_Store
**/*.AppleDouble
.gitsecret/keys/random_seed
!*.secret
random_seed
junit-report.html
junit-report.xml
.env

# Python cache artifacts
__pycache__/
*.py[cod]

# Local dev hygiene
.DS_Store
**/.DS_Store
.AppleDouble
**/.AppleDouble
._*
.Spotlight-V100/
.Trashes/
.fseventsd

# Python local environments/caches
.venv/
.venv*/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*

# Python runtime artifacts
migration/python-api/runtime/files/*
!migration/python-api/runtime/files/.gitkeep
