# Runtime ports/image
APP_PORT=8080
API_IMAGE=123456789012.dkr.ecr.us-east-1.amazonaws.com/api-hacienda:latest

# Core app config
API_HACIENDA_ENV=production
API_HACIENDA_LOG_LEVEL=INFO
API_HACIENDA_CRYPTO_KEY=CHANGE_ME_WITH_A_STRONG_RANDOM_KEY
API_HACIENDA_DATABASE_URL=mysql+pymysql://app_user:app_password@my-rds.cluster-xxxx.us-east-1.rds.amazonaws.com:3306/api_hacienda
API_HACIENDA_DB_BACKEND=rds_data_api
API_HACIENDA_AWS_REGION=us-east-1
API_HACIENDA_RDS_DATA_RESOURCE_ARN=arn:aws:rds:us-east-1:123456789012:cluster:api-hacienda-aurora
API_HACIENDA_RDS_DATA_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:api-hacienda-rds-data
API_HACIENDA_RDS_DATA_DATABASE=api_hacienda
API_HACIENDA_FE_ASYNC_ENABLED=true
API_HACIENDA_FE_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/api-hacienda-fe.fifo
API_HACIENDA_FE_WORKER_BATCH_SIZE=10
API_HACIENDA_FE_RETRY_BASE_SECONDS=60
API_HACIENDA_FE_RETRY_MAX_SECONDS=21600
API_HACIENDA_FE_RETRY_JITTER_SECONDS=30
API_HACIENDA_FE_RETRY_MAX_ATTEMPTS=256
API_HACIENDA_FE_RETRY_MAX_AGE_SECONDS=604800
API_HACIENDA_FE_CONSULT_DELAY_SECONDS=300
API_HACIENDA_FE_STUCK_PROCESSING_SECONDS=900

# Optional mail settings
API_HACIENDA_CORE_SITE_NAME=API Hacienda
API_HACIENDA_MAIL_NOREPLY=no-reply@example.com
API_HACIENDA_MAIL_TYPE=mail
API_HACIENDA_MAIL_ADDRESS=
API_HACIENDA_MAIL_HOST=
API_HACIENDA_MAIL_USERNAME=
API_HACIENDA_MAIL_PASSWORD=
API_HACIENDA_MAIL_SECURE=tls
API_HACIENDA_MAIL_PORT=587
